# Prefijo de ruta cuando el sitio no vive en la raíz del dominio.
# GitHub Pages (raices-desarrollos.github.io/Raices-Web) usa /Raices-Web.
# Con dominio propio o en desarrollo local, dejar vacío.
NEXT_PUBLIC_BASE_PATH=

# Origen público del sitio, sin basePath. Se usa para canonical, Open Graph y sitemap.
# Por defecto: https://raices-desarrollos.github.io
NEXT_PUBLIC_SITE_URL=

# Número de WhatsApp en formato internacional sin "+" ni espacios (+54 9 11 3699-4200).
NEXT_PUBLIC_WHATSAPP_NUMBER=5491136994200

# URL pública del worker de contacto, una vez desplegado (ver functions/README.md).
# Si está vacío, el formulario no finge un envío por email.
NEXT_PUBLIC_FORM_ENDPOINT=

# Video del hero institucional. Copiar el mp4 a public/assets/video/ y poner acá
# la ruta, por ejemplo /assets/video/raices-hero.mp4 (H.264, sin audio, ideal ≤ 6 MB).
NEXT_PUBLIC_HERO_VIDEO=

# --- Solo el worker de email (nunca NEXT_PUBLIC_): ver functions/contact-worker.js ---
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# RESEND_API_KEY=
# ALLOWED_ORIGIN=
